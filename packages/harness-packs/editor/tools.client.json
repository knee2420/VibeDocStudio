    {
        "name": "assets.propose",
        "description": "에셋 블록 제안 통합 도구 (Staged Unified Diff). 데이터 출처(sourceBlockIds 기존 이관 + items/records 새 데이터 보강)와 배치 방식(mode: replace | insert)을 자유롭게 조합한다. 직전 대기열(workbench.stagedChanges)의 제안을 수정할 때는 revisionOf 에 diffId 를 넘겨 중복 카드 없이 제자리 갱신한다.",
        "risk": "read",
        "inputSchema": {
            "type": "object",
            "properties": {
                "assetId": {
                    "type": "string"
                },
                "mode": {
                    "type": "string",
                    "enum": [
                        "replace",
                        "insert"
                    ],
                    "description": "replace = 기존 블록 교체, insert = 기준 블록 아래(또는 첫 쪽 끝)에 추가. 생략 시 replaceBlockIds 가 있으면 replace, 아니면 insert"
                },
                "replaceBlockIds": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "교체할 기존 블록 ID 목록 (사용자가 Unified Diff 에서 교체↔추가 전환할 때도 기준 블록으로 쓰임)"
                },
                "afterBlockId": {
                    "type": "string",
                    "description": "insert 시 이 블록 바로 뒤에 놓는다 (없으면 첫 쪽 끝)"
                },
                "sourceBlockIds": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "기존 블록에서 자동 추출해 이관할 원본 블록 ID 목록 (items/records 와 함께 주면 추출분 위에 보강)"
                },
                "items": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "label": {
                                "type": "string"
                            },
                            "value": {
                                "type": "string"
                            },
                            "rows": {
                                "type": "array",
                                "items": {
                                    "type": "object"
                                }
                            }
                        },
                        "required": [
                            "label"
                        ]
                    }
                },
                "records": {
                    "type": "object",
                    "description": "정확한 필드 id → 값 (반복 id → 레코드 배열)"
                },
                "revisionOf": {
                    "type": "string",
                    "description": "workbench.stagedChanges 에 있는 기존 제안 diffId 를 제자리 수정할 때 지정"
                },
                "intentNote": {
                    "type": "string",
                    "description": "교체/추가 방식을 고른 짧은 근거 (캔버스 Unified Diff 헤더에 표시)"
                }
            },
            "required": [
                "assetId"
            ]
        }
    },
