{
 "version": "1.0",
 "headingPatterns": [
  "^(제\\s*\\d+\\s*[편장절관조항])(?:\\s|$)",
  "^(\\d+(?:\\.\\d+){0,3}\\.?)\\s+\\S",
  "^([I|V|X|Ⅰ|Ⅱ|Ⅲ|Ⅳ|Ⅴ|Ⅵ|Ⅶ|Ⅷ|Ⅸ|Ⅹ]+\\.)\\s+\\S",
  "^([가-하]\\.)\\s+\\S",
  "^([가-하]\\))\\s+\\S",
  "^(\\d+\\))\\s+\\S",
  "^(\\(\\d+\\))\\s+\\S",
  "^([①-⑳])\\s*\\S",
  "^(【[^】]{1,24}】)\\s*"
 ],
 "listMarkerPatterns": [
  {"kind": "number", "pattern": "^(\\d{1,3}\\.(?:\\d{1,3}\\.)*)\\s+"},
  {"kind": "paren", "pattern": "^((?:\\(\\d{1,3}\\)|\\d{1,3}\\)))\\s+"},
  {"kind": "korean", "pattern": "^((?:[가-하]\\.|\\([가-하]\\)|[가-하]\\)))\\s+"},
  {"kind": "circled", "pattern": "^([①-⑳⑴-⒇ⓐ-ⓩ])\\s*"},
  {"kind": "bullet", "pattern": "^([•·▪▫◦○●□■◆◇▶▷▹▸※★☆\\-―–‣])\\s*"}
 ],
 "captionPatterns": [
  "^\\s*(?:\\[|<)\\s*(?:표|도표|그림|사진|붙임|별표|첨부|참고|Table|Fig(?:ure)?\\.?)\\s*[\\d\\-.]*\\s*(?:\\]|>)",
  "^\\s*(?:표|도표|그림|사진|붙임|별표|첨부|참고|Table|Fig(?:ure)?\\.?)\\s*\\d+(?:[\\-.]\\d+)*(?=\\s*(?:[:.\\]>]|$)|\\s)",
  "^\\s*(?:표|도표|그림|사진|붙임|별표|첨부|참고|Table|Fig(?:ure)?\\.?)\\s*[:.]"
 ],
 "pageCounterPatterns": [
  "^\\(\\s*\\d+\\s*쪽\\s*중\\s*\\d+\\s*쪽\\s*\\)$",
  "^[-–—]\\s*\\d+\\s*[-–—]$",
  "^\\d+\\s*/\\s*\\d+\\s*(?:쪽|p|page)?$",
  "^Page\\s+\\d+(?:\\s+of\\s+\\d+)?$"
 ],
 "articleBoundaryPatterns": [
  "^제\\s*\\d+\\s*[조편장절관]\\s*(?:\\([^)]*\\)|$)"
 ],
 "notePatterns": [
  "^\\s*(?:\\*+|※|주\\s*[:.\\d)]|참고\\s*[:.]|비고\\s*[:.]|출처\\s*[:.])"
 ],
 "fieldPatterns": {
  "date": [
   "(?:20\\d{2}|19\\d{2}|\\d{2,4}|_{2,})?\\s*년\\s*(?:_{1,}|\\s{2,})\\s*월\\s*(?:_{1,}|\\s{2,}|\\d{1,2})?\\s*일",
   "(?:20\\d{2}|19\\d{2})?\\s*년\\s*\\d{1,2}\\s*월\\s*(?:_{1,}|\\s{2,})\\s*일",
   "_{2,}\\s*년\\s*[\\d_\\s]*월\\s*[\\d_\\s]*일",
   "\\d{4}[./-]\\s*[\\s_]{2,}[./-]\\s*[\\s_]{2,}"
  ],
   "sign": [
    "\\(\\s*(?:서명(?:\\s*(?:및|또는)\\s*(?:인|날인))?|인|날인)\\s*\\)",
    "(?:서명\\s*(?:및|또는)\\s*(?:인|날인)|신청인|작성자|대표자|확인자)\\s*[:：]?\\s*(?:\\(\\s*(?:인|서명)\\s*\\))?$"
   ],
  "underlineRun": "_{3,}|\\.{5,}|─{3,}",
  "checkboxGlyphs": ["□", "☐", "☑", "☒", "✔", "✓", "■"]
 },
 "emptyCellPlaceholders": ["", "-", "—", "/", "해당없음", "해당 없음", "없음", "미작성"],
 "ocrNumericPattern": "^[\\d\\s.,:%+\\-/~()₩$원개년월일호명건]+$",
 "fontAliases": {
  "gulim": "'Gulim', '굴림', 'Malgun Gothic', sans-serif",
  "gulimche": "'GulimChe', '굴림체', 'Gulim', monospace",
  "dotum": "'Dotum', '돋움', 'Malgun Gothic', sans-serif",
  "batang": "'Batang', '바탕', 'NanumMyeongjo', serif",
  "batangche": "'BatangChe', '바탕체', 'Batang', serif",
  "malgun gothic": "'Malgun Gothic', '맑은 고딕', 'Apple SD Gothic Neo', sans-serif",
  "nanumgothic": "'NanumGothic', '나눔고딕', 'Malgun Gothic', sans-serif",
  "nanummyeongjo": "'NanumMyeongjo', '나눔명조', 'Batang', serif",
  "hy신명조": "'HY신명조', 'Batang', serif",
  "함초롬바탕": "'HCR Batang', '함초롬바탕', 'Batang', serif",
  "함초롬돋움": "'HCR Dotum', '함초롬돋움', 'Dotum', 'Malgun Gothic', sans-serif"
 },
 "lineGroup": {
  "minGapRatio": 2.2,
  "sameBaselineTolPt": 2.5
 },
 "tocLeader": {
  "leaderPattern": "(?:\\.{3,}|…{2,}|-{4,}|_{4,}|·{3,})",
  "pageNumPattern": "(?:^|\\s)(?:\\d{1,4}|-\\s*\\d+\\s*-)\\s*$"
 },
 "runningHeader": {
  "topRatio": 0.14,
  "bottomRatio": 0.12,
  "minPageFraction": 0.5,
  "minPages": 2
 },
 "scanFontScale": 0.85,
 "scanBoxFontScale": 0.72,
 "ocrConfusions": [
  {"wrong": "\\b제\\s*([0-9oOlI]+)\\s*조", "kind": "article_zero_oh"},
  {"wrong": "원(\\s|$)", "right": "원\\1"},
  {"from": "AI", "to": "시", "when": "ko_context"},
  {"from": "Ⅹ", "to": "X", "when": "roman_or_latin"}
 ]
}
