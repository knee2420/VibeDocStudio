{
 "version": "1.0",
 "headingPatterns": [
  "^(제\\s*\\d+\\s*[편장절관조항])(?:\\s|$)",
  "^(\\d+(?:\\.\\d+){0,3}\\.?)\\s+\\S",
  "^([I|V|X|Ⅰ|Ⅱ|Ⅲ|Ⅳ|Ⅴ|Ⅵ|Ⅶ|Ⅷ|Ⅸ|Ⅹ]+\\.)\\s+\\S",
  "^([가-하]\\.)\\s+\\S",
  "^([가-하]\\))\\s+\\S",
  "^(\\d+\\))\\s+\\S",
  "^(\\(\\d+\\))\\s+\\S",
  "^([①-⑳])\\s*\\S",
  "^(【[^】]{1,24}】)\\s*"
 ],
 "listMarkerPatterns": [
  {"kind": "number", "pattern": "^(\\d{1,3}\\.(?:\\d{1,3}\\.)*)\\s+"},
  {"kind": "paren", "pattern": "^((?:\\(\\d{1,3}\\)|\\d{1,3}\\)))\\s+"},
  {"kind": "korean", "pattern": "^((?:[가-하]\\.|\\([가-하]\\)|[가-하]\\)))\\s+"},
  {"kind": "circled", "pattern": "^([①-⑳⑴-⒇ⓐ-ⓩ])\\s*"},
  {"kind": "bullet", "pattern": "^([•·▪▫◦○●□■◆◇▶▷▹▸※★☆\\-―–‣])\\s*"}
 ],
 "captionPatterns": [
  "^\\s*(?:\\[|<)\\s*(?:표|도표|그림|사진|붙임|별표|첨부|참고|Table|Fig(?:ure)?\\.?)\\s*[\\d\\-.]*\\s*(?:\\]|>)",
  "^\\s*(?:표|도표|그림|사진|붙임|별표|첨부|참고|Table|Fig(?:ure)?\\.?)\\s*\\d+(?:[\\-.]\\d+)*(?=\\s*(?:[:.\\]>]|$)|\\s)",
  "^\\s*(?:표|도표|그림|사진|붙임|별표|첨부|참고|Table|Fig(?:ure)?\\.?)\\s*[:.]"
 ],
 "pageCounterPatterns": [
  "^\\(\\s*\\d+\\s*쪽\\s*중\\s*\\d+\\s*쪽\\s*\\)$",
  "^[-–—]\\s*\\d+\\s*[-–—]$",
  "^\\d+\\s*/\\s*\\d+\\s*(?:쪽|p|page)?$",
  "^Page\\s+\\d+(?:\\s+of\\s+\\d+)?$"
 ],
 "articleBoundaryPatterns": [
  "^제\\s*\\d+\\s*[조편장절관]\\s*(?:\\([^)]*\\)|$)"
 ],
 "notePatterns": [
  "^\\s*(?:\\*+|※|주\\s*[:.\\d)]|참고\\s*[:.]|비고\\s*[:.]|출처\\s*[:.])"
 ],
 "fieldPatterns": {
  "date": [
   "(?:20\\d{2}|19\\d{2}|\\d{2,4}|_{2,})?\\s*년\\s*(?:_{1,}|\\s{2,})\\s*월\\s*(?:_{1,}|\\s{2,}|\\d{1,2})?\\s*일",
   "(?:20\\d{2}|19\\d{2})?\\s*년\\s*\\d{1,2}\\s*월\\s*(?:_{1,}|\\s{2,})\\s*일",
   "_{2,}\\s*년\\s*[\\d_\\s]*월\\s*[\\d_\\s]*일",
   "\\d{4}[./-]\\s*[\\s_]{2,}[./-]\\s*[\\s_]{2,}"
  ],
  "sign": [
   "\\(\\s*(?:서명|인|날인)\\s*\\)",
   "(?:서명\\s*및\\s*날인|서명\\s*또는\\s*인|신청인|작성자|대표자|확인자)\\s*[:：]?\\s*(?:\\(\\s*(?:인|서명)\\s*\\))?$"
  ],
  "underlineRun": "_{3,}|\\.{5,}|─{3,}",
  "checkboxGlyphs": ["□", "☐", "☑", "☒", "✔", "✓", "■"]
 },
 "emptyCellPlaceholders": ["", "-", "—", "/", "해당없음", "해당 없음", "없음", "미작성"],
 "ocrNumericPattern": "^[\\d\\s.,:%+\\-/~()₩$원개년월일호명건]+$"
}
