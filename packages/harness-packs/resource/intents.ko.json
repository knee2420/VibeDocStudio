{
 "_doc": "'전체 읽기' 요청 감지 — 묶음 전체를 다루라는 요청이면 읽은 범위 재확인이 켜진다.",
 "casualExclusions": {
  "pattern": "전체적|전반적|모든\\s*면|모든\\s*각도|모든\\s*관점"
 },
 "fullReadExplicit": {
  "pattern": "(?:전수\\s*(?:조사|검사|확인)|(?:모든|전체|전부)\\s*(?:파일|문서|자료)|(?:빠짐없이|빠짐\\s*없이|하나도\\s*빠짐없이|샅샅이|통째로?)\\s*(?:다\\s*)?(?:읽|확인|검토|비교)|(?:파일|문서|자료)(?:들을?|를?)\\s*(?:모두|전부|다)\\s*(?:읽|확인|검토))"
 },
 "categoryPluralRead": {
  "pattern": "(?P<target>[a-zA-Z0-9가-힣_-]+)\\s?들(?:을|를|의|에서|이|은|는)?\\s*(?:다|전부|모두|싹)?\\s*(?:을\\s*)?(?:읽|확인|검토|비교|분석|정리|요약|종합|모아|훑|살펴|추려|표로|묶어|대조)"
 },
 "allOfTarget": {
  "pattern": "(?:모든|전체)\\s+(?P<target>[a-zA-Z0-9가-힣_-]{2,})"
 },
 "notTargets": [
  "것",
  "그",
  "그것",
  "내용",
  "너희",
  "문서",
  "분",
  "사람",
  "여러분",
  "우리",
  "이",
  "이것",
  "자료",
  "저",
  "저희",
  "파일"
 ]
}
