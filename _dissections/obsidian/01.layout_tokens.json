  "themes": {
    "dark": {
      "--obs-bg-primary": "#1e1e1e",
      "--obs-bg-primary-alt": "#242424",
      "--obs-bg-secondary": "#262626",
      "--obs-bg-secondary-alt": "#1a1a1a",
      "--obs-bg-tab-bar": "#262626",
      "--obs-bg-hover": "rgba(255, 255, 255, 0.067)",
      "--obs-bg-active": "rgba(255, 255, 255, 0.11)",
      "--obs-bg-selected": "rgba(138, 92, 245, 0.22)",
      "--obs-bg-drop-overlay": "rgba(138, 92, 245, 0.20)",
      "--obs-border": "#363636",
      "--obs-border-subtle": "#2d2d2d",
      "--obs-indent-guide": "rgba(255, 255, 255, 0.10)",
      "--obs-indent-guide-active": "rgba(255, 255, 255, 0.26)",
      "--obs-text-normal": "#dadada",
      "--obs-text-muted": "#b3b3b3",
      "--obs-text-faint": "#666666",
      "--obs-accent": "#8a5cf5",
      "--obs-accent-hover": "#a68af9",
      "--obs-danger": "#fb464c"
    },
    "light": {
      "--obs-bg-primary": "#ffffff",
      "--obs-bg-primary-alt": "#fafafa",
      "--obs-bg-secondary": "#f6f6f6",
      "--obs-bg-secondary-alt": "#ededed",
      "--obs-bg-tab-bar": "#f2f2f2",
      "--obs-bg-hover": "rgba(0, 0, 0, 0.055)",
      "--obs-bg-active": "rgba(0, 0, 0, 0.085)",
      "--obs-bg-selected": "rgba(124, 58, 237, 0.14)",
      "--obs-bg-drop-overlay": "rgba(124, 58, 237, 0.16)",
      "--obs-border": "#e0e0e0",
      "--obs-border-subtle": "#ebebeb",
      "--obs-indent-guide": "rgba(0, 0, 0, 0.10)",
      "--obs-indent-guide-active": "rgba(0, 0, 0, 0.28)",
      "--obs-text-normal": "#222222",
      "--obs-text-muted": "#5c5c5c",
      "--obs-text-faint": "#ababab",
      "--obs-accent": "#7c3aed",
      "--obs-accent-hover": "#6d28d9",
      "--obs-danger": "#e93147"
