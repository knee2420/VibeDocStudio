{
  "target": "Obsidian Desktop (v1.7+ default theme)",
  "scope": ["Vault", "File Explorer", "Tab & Split Layout", "Ribbon & Status Bar"],
  "geometry": {
    "ribbonWidthPx": 44,
    "leftSidebarDefaultWidthPx": 260,
    "leftSidebarMinWidthPx": 180,
    "leftSidebarMaxWidthPx": 480,
    "tabHeaderHeightPx": 36,
    "tabMinWidthPx": 90,
    "tabMaxWidthPx": 200,
    "tabRadiusTopPx": 6,
    "viewHeaderHeightPx": 34,
    "statusBarHeightPx": 24,
    "dividerWidthPx": 1,
    "dividerHitAreaPx": 6,
    "navHeaderHeightPx": 36,
    "navItemHeightPx": 27,
    "navItemFontSizePx": 13,
    "navItemLineHeightPx": 18,
    "navItemPaddingY": 4,
    "navItemPaddingX": 8,
    "navItemRadiusPx": 4,
    "navIndentStepPx": 16,
    "navIndentGuideWidthPx": 1,
    "navIconSizePx": 14,
    "splitMinPaneRatio": 0.12,
    "dockEdgeZoneRatio": 0.25,
    "springLoadedFolderDelayMs": 550
