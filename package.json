{
  "name": "vibe-doc-studio",
  "version": "0.2.0",
  "private": true,
  "description": "PandaDoc 3-Pane Shell + AI WYSIWYG (Tiptap) + WYSIWYM (CSS Grid/Slot) + Component-Attached AI Composer Studio",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @vibe/api --filter @vibe/studio --parallel dev",
    "dev:studio": "pnpm --filter @vibe/studio dev",
    "dev:playground": "pnpm --filter @vibe/api --filter @vibe/playground --parallel dev",
    "dev:playground:web": "pnpm --filter @vibe/playground dev",
    "dev:api": "pnpm --filter @vibe/api dev",
    "lint": "pnpm -r lint",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @vibe/vdoc-schema --filter @vibe/slot-canvas --filter @vibe/selection-core --filter @vibe/ai-scope --filter @vibe/vault-formats --filter @vibe/outline-sync --filter @vibe/canvas-state --filter @vibe/ai-vault --filter @vibe/api test && pnpm test:arch",
    "test:arch": "node --test tests/architecture/package-boundaries.test.mjs",
    "perf:v2": "python scripts/v2_perf.py"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
